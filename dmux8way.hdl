CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux(in=in, sel=sel[2], a=abcdIn, b=efghIn);

    DMux(in=abcdIn, sel=sel[1], a=aIn, b=bIn);
    DMux(in=efghIn, sel=sel[1], a=cIn, b=dIn);

    DMux(in=aIn, sel=sel[0], a=a, b=b);
    DMux(in=bIn, sel=sel[0], a=c, b=d);
    DMux(in=cIn, sel=sel[0], a=e, b=f);
    DMux(in=dIn, sel=sel[0], a=g, b=h);
}
