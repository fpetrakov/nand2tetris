CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    Mux16(a=x, b[0..15]=false, sel=zx, out=xZero);
    Not16(in=xZero, out=xNot);
    Mux16(a=xZero, b=xNot, sel=nx, out=xNeg);

    Mux16(a=y, b[0..15]=false, sel=zy, out=yZero);
    Not16(in=yZero, out=yNot);
    Mux16(a=yZero, b=yNot, sel=ny, out=yNeg);

    Add16(a=xNeg, b=yNeg, out=xySum);
    And16(a=xNeg, b=yNeg, out=xyAnd);
    Mux16(a=xyAnd, b=xySum, sel=f, out=xyOut);
    
    Not16(in=xyOut, out=xyNot);
    Mux16(a=xyOut, b=xyNot, sel=no, out=out, out[15]=ng, out[0..7]=low, out[8..15]=high);

    Or8Way(in=low, out=orLow);
    Or8Way(in=high, out=orHigh);
    Or(a=orLow, b=orHigh, out=anyOne);
    Not(in=anyOne, out=zr);
}
